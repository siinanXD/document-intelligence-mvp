# Copy to .env and fill in locally. Never commit a filled .env.
# Variable names only - no values, no secrets.

# --- Application ---
ENVIRONMENT=
LOG_LEVEL=
HEALTH_CHECK_TIMEOUT_SECONDS=
# Comma-separated browser origins. Empty uses local defaults
# (http://127.0.0.1:3000, http://localhost:3000) when ENVIRONMENT=local.
CORS_ORIGINS=

# --- PostgreSQL ---
DATABASE_URL=
DATABASE_POOL_SIZE=
DATABASE_ECHO=

# --- Qdrant ---
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION=
QDRANT_DOCUMENTS_COLLECTION=
QDRANT_TIMEOUT_SECONDS=

# --- Object storage (local filesystem in dev, S3-compatible in production) ---
STORAGE_BACKEND=
STORAGE_LOCAL_PATH=
MAX_UPLOAD_BYTES=
S3_ENDPOINT_URL=
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# --- Parsing (worker) ---
DOCLING_ARTIFACTS_PATH=
DOCLING_DO_OCR=
DOCLING_DO_TABLE_STRUCTURE=

# --- Worker ---
WORKER_ID=
WORKER_BATCH_SIZE=
WORKER_IDLE_SLEEP_SECONDS=
WORKER_RETRY_DELAY_SECONDS=

# --- AI providers ---
EMBEDDING_PROVIDER=
EMBEDDING_MODEL=
EMBEDDING_VERSION=
EMBEDDING_BATCH_SIZE=
LLM_PROVIDER=
LLM_MODEL=
LLM_TIMEOUT_SECONDS=
LLM_MAX_RETRIES=
LLM_MAX_OUTPUT_TOKENS=
LLM_TEMPERATURE=
LLM_INPUT_USD_PER_MILLION=
LLM_OUTPUT_USD_PER_MILLION=
OPENAI_API_KEY=
# Read once the Hugging Face embedding provider lands.
HUGGINGFACE_EMBEDDINGS_BASE_URL=
HUGGINGFACE_API_KEY=

# --- Observability (optional; requests work with tracing off) ---
TRACING_PROVIDER=
# Development-only. Off by default. When true, traces may include prompts and
# model output. Unrelated debug flags do not enable this.
TRACING_CAPTURE_CONTENT=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=
LANGFUSE_BASE_URL=

# --- Search ---
SEARCH_DEFAULT_LIMIT=
SEARCH_MAX_LIMIT=
ASK_DEFAULT_LIMIT=
ASK_MAX_LIMIT=

# --- Document relations ---
RELATION_VERSION_SIMILARITY=
RELATION_RELATED_SIMILARITY=
RELATION_MIN_SHARED_IDENTIFIERS=
RELATION_MIN_SHARED_ENTITIES=
RELATION_MAX_CANDIDATES=

# --- Production (Railway). Names only. PORT is injected by the platform. ---
# API_UPSTREAM_URL is web-only (private API host). Never a NEXT_PUBLIC_* value.
# NEXT_PUBLIC_API_BASE_URL=/backend
# API_UPSTREAM_URL=
# STORAGE_BACKEND=s3

