# Copy to .env and fill in locally. Never commit a filled .env.
# Variable names only - no values, no secrets.

# --- Application ---
ENVIRONMENT=
LOG_LEVEL=
HEALTH_CHECK_TIMEOUT_SECONDS=

# --- PostgreSQL ---
DATABASE_URL=
DATABASE_POOL_SIZE=
DATABASE_ECHO=

# --- Qdrant ---
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION=
QDRANT_DOCUMENTS_COLLECTION=
QDRANT_TIMEOUT_SECONDS=

# --- Object storage (local filesystem in dev, S3-compatible in production) ---
STORAGE_BACKEND=
STORAGE_LOCAL_PATH=
MAX_UPLOAD_BYTES=
S3_ENDPOINT_URL=
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# --- Parsing (worker) ---
DOCLING_ARTIFACTS_PATH=
DOCLING_DO_OCR=
DOCLING_DO_TABLE_STRUCTURE=

# --- Worker ---
WORKER_ID=
WORKER_BATCH_SIZE=
WORKER_IDLE_SLEEP_SECONDS=
WORKER_RETRY_DELAY_SECONDS=

# --- AI providers ---
EMBEDDING_PROVIDER=
EMBEDDING_MODEL=
EMBEDDING_VERSION=
EMBEDDING_BATCH_SIZE=
LLM_PROVIDER=
LLM_MODEL=
OPENAI_API_KEY=
# Read once the Hugging Face embedding provider lands.
HUGGINGFACE_EMBEDDINGS_BASE_URL=
HUGGINGFACE_API_KEY=

# --- Search ---
SEARCH_DEFAULT_LIMIT=
SEARCH_MAX_LIMIT=
ASK_DEFAULT_LIMIT=
ASK_MAX_LIMIT=

# --- Document relations ---
RELATION_VERSION_SIMILARITY=
RELATION_RELATED_SIMILARITY=
RELATION_MIN_SHARED_IDENTIFIERS=
RELATION_MIN_SHARED_ENTITIES=
RELATION_MAX_CANDIDATES=
