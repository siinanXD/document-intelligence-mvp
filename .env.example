# Copy to .env and fill in locally. Never commit a filled .env.
# Variable names only - no values, no secrets.

# --- Application ---
ENVIRONMENT=
LOG_LEVEL=

# --- PostgreSQL (added with the core platform work) ---
DATABASE_URL=

# --- Qdrant ---
QDRANT_URL=
QDRANT_API_KEY=

# --- Object storage (local filesystem in dev, S3-compatible in production) ---
STORAGE_BACKEND=
STORAGE_LOCAL_PATH=
S3_ENDPOINT_URL=
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# --- AI providers ---
EMBEDDING_PROVIDER=
EMBEDDING_MODEL=
LLM_PROVIDER=
LLM_MODEL=
OPENAI_API_KEY=
HUGGINGFACE_EMBEDDINGS_BASE_URL=
HUGGINGFACE_API_KEY=
